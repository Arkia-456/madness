<div class='tooltip actions'>
	<div>
		<div>{{localize 'Madness.Label.Description'}}</div>
		<div>
			{{#if system.description}}
				{{{system.description}}}
			{{else}}
				-
			{{/if}}
		</div>
	</div>
	<table class='stats'>
		<tr>
			<td>{{localize 'Madness.Label.Damage'}}</td>
			<td>{{localize 'Madness.Label.CriticalFailureScore'}}</td>
			<td>{{localize 'Madness.Label.CriticalSuccessScore'}}</td>
		</tr>
		<tr>
			<td>{{damageFormula}}</td>
			<td>&lt;= {{criticalFailureScore}}</td>
			<td>&gt; {{criticalSuccessScore}}</td>
		</tr>
	</table>
	<table class='effects'>
		{{#each effects}}
			<tr>
				<td>{{name}}</td>
				<td>{{{system.description}}}</td>
				<td>{{system.strength}}</td>
			</tr>
		{{/each}}
	</table>
</div>