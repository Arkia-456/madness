<div class='tooltip actions'>
	<div>
		<div>{{localize 'Madness.Label.Description'}}</div>
		<div>
			{{#if system.description}}
				{{{system.description}}}
			{{else}}
				-
			{{/if}}
		</div>
	</div>
	<table>
		<tr>
			<td colspan='2'>{{localize 'Madness.Label.Magics'}}</td>
		</tr>
		<tr>
			{{#each system.requirements}}
				<td class='magic'>
					<p>{{localize (lookup (lookup @root.magics id) 'label')}}</p>
					{{#if id}}
						<p>{{localize (lookup (lookup @root.magics id) 'description')}}
							{{#if (lookup (lookup @root.magics id) 'effects')}}
								{{lower (localize 'Madness.Misc.Of')}}
							{{/if}}
							{{#each (lookup (lookup @root.magics id) 'effects')}}
								{{#if (gt @index 0)}}
									{{lower (localize 'Madness.Misc.And')}}
								{{/if}}
								{{value}}
								{{#if (gt @index 0)}}
									{{lower (localize 'Madness.Misc.Respectively')}}
								{{/if}}
							{{/each}}
						</p>
					{{/if}}
				</td>
			{{/each}}
		</tr>
	</table>
	<table class='stats'>
		<tr>
			<td>{{localize 'Madness.Label.Damage'}}</td>
			<td>{{localize 'Madness.Label.CriticalFailureScore'}}</td>
			<td>{{localize 'Madness.Label.CriticalSuccessScore'}}</td>
		</tr>
		<tr>
			<td>{{damageFormula}}</td>
			<td>&lt;= {{criticalFailureScore}}</td>
			<td>&gt;= {{criticalSuccessScore}}</td>
		</tr>
	</table>
	<table class='effects'>
		{{#each effects}}
			<tr>
				<td>{{name}}</td>
				<td>{{{system.description}}}</td>
				<td>{{system.strength}}</td>
			</tr>
		{{/each}}
	</table>
</div>