<form autocomplete='off'>
	<table>
		{{#each system.attributes as |attribute id|}}
			<tr>
				<td class='header'>{{localize (lookup @root.attributesLabels id)}}</td>
				<td class='value' data-id='{{id}}'>
					<input
						type='number'
						name='{{id}}'
						value='{{attribute.value}}'
						min='0'
						step='1'
					/>
				</td>
			</tr>
		{{/each}}
	</table>
	<button type='submit'>
		<i class='fa-regular fa-save'></i>
		{{localize 'Save'}}
	</button>
</form>