<section class='tab inventory' data-tab='inventory'>
	<div class='section-header top'>{{localize 'Madness.Label.Equipment'}}</div>
	<table>
		<tr class='head'>
			<td>{{localize 'Madness.Equipment.Slots.Head'}}</td>
			<td class='value'>{{localize 'Madness.Label.Armor'}}</td>
			<td class='value'>{{localize 'Madness.Label.Weight'}}</td>
			<td class='actions'></td>
		</tr>
		<tr data-id='{{equipments.head.id}}'>
			<td>{{equipments.head.name}}</td>
			<td class='value'>{{equipments.head.system.armor}}</td>
			<td class='value'>{{equipments.head.system.weight}}</td>
			<td class='actions'>
				{{#if equipments.head}}
					<a data-action='delete'>
						<i class='fa fa-trash'></i>
					</a>
					<a data-action='edit-item' data-item-id='{{equipments.head.id}}'>
						<i class='fa-solid fa-fw fa-edit'></i>
					</a>
				{{/if}}
			</td>
		</tr>
	</table>
	<table>
		<tr class='head'>
			<td>{{localize 'Madness.Equipment.Slots.Body'}}</td>
			<td class='value'>{{localize 'Madness.Label.Armor'}}</td>
			<td class='value'>{{localize 'Madness.Label.Weight'}}</td>
			<td class='actions'></td>
		</tr>
		<tr data-id='{{equipments.body.id}}'>
			<td>{{equipments.body.name}}</td>
			<td class='value'>{{equipments.body.system.armor}}</td>
			<td class='value'>{{equipments.body.system.weight}}</td>
			<td class='actions'>
				{{#if equipments.body}}
					<a data-action='delete'>
						<i class='fa fa-trash'></i>
					</a>
					<a data-action='edit-item' data-item-id='{{equipments.body.id}}'>
						<i class='fa-solid fa-fw fa-edit'></i>
					</a>
				{{/if}}
			</td>
		</tr>
	</table>
	<table>
		<tr class='head'>
			<td>{{localize 'Madness.Equipment.Slots.Legs'}}</td>
			<td class='value'>{{localize 'Madness.Label.Armor'}}</td>
			<td class='value'>{{localize 'Madness.Label.Weight'}}</td>
			<td class='actions'></td>
		</tr>
		<tr data-id='{{equipments.legs.id}}'>
			<td>{{equipments.legs.name}}</td>
			<td class='value'>{{equipments.legs.system.armor}}</td>
			<td class='value'>{{equipments.legs.system.weight}}</td>
			<td class='actions'>
				{{#if equipments.legs}}
					<a data-action='delete'>
						<i class='fa fa-trash'></i>
					</a>
					<a data-action='edit-item' data-item-id='{{equipments.legs.id}}'>
						<i class='fa-solid fa-fw fa-edit'></i>
					</a>
				{{/if}}
			</td>
		</tr>
	</table>
	<table class='weapons'>
		<tr class='head'>
			<td colspan='2'>{{localize 'Madness.Label.Weapons'}}</td>
			<td class='value'>{{localize 'Madness.Label.Weight'}}</td>
			<td class='actions'></td>
		</tr>
		{{#each weapons}}
			<tr data-id='{{id}}'>
				<td class='head'>{{localize 'Madness.Label.Weapon'}}
					{{add @index 1}}</td>
				<td>{{name}}</td>
				<td>{{system.weight}}</td>
				<td class='actions'>
					<a data-action='delete'>
						<i class='fa fa-trash'></i>
					</a>
					<a data-action='edit-item' data-item-id='{{id}}'>
						<i class='fa-solid fa-fw fa-edit'></i>
					</a>
				</td>
			</tr>
		{{/each}}
		{{#times (minus config.weaponMaxSlots weapons.length)}}
			<tr class='placeholder'>
				<td class='head'></td>
				<td></td>
				<td></td>
				<td class='actions'></td>
			</tr>
		{{/times}}
	</table>
	<table class='equipment-weight-summary'>
		<tr>
			<td class='head'>{{localize 'Madness.Equipment.EquipmentWeight'}}</td>
			<td class='value'>{{system.currentEquipmentWeight}}</td>
			<td class='value'>/
				{{system.secondaryAttributes.maxEquipmentWeight.total}}</td>
			<td class='actions'></td>
		</tr>
	</table>
</section>