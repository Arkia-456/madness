<section class='tab actions' data-tab='actions'>
	<div class='section-header top'>{{localize 'Madness.Label.MagicSkills'}}</div>
	<section class='item-list spells'>
		<div class='row'>
			<div class='item-name'>{{localize 'Madness.Label.Name'}}</div>
			<div>{{localize 'Madness.Label.Magics'}}</div>
			<div>{{localize 'Madness.Item.Spell.Cost'}}</div>
			<div>{{localize 'Madness.Item.Damage'}} <br /> min-max</div>
			<div>{{localize 'Madness.Item.Range'}}</div>
		</div>
		{{#each spells}}
			<div class='item spell' data-id='{{id}}'>
				<div class='row'>
					<div class='item-name'>{{name}}</div>
					<div class='magic-icons'>
						{{#each system.requirements}}
							{{#if id}}
								<img src='systems/madness/resources/icons/magics/{{id}}.png' />
							{{/if}}
						{{/each}}
					</div>
					<div>{{cost}}</div>
					<div>
						{{minDamage}}
						-
						{{maxDamage}}
					</div>
					<div>{{range}}</div>
					<button class='action' data-action='roll-spell'>
						{{localize 'Madness.Controls.Attack'}}
					</button>
					<div class='delete'>
						<a data-action='delete'>
							<i class='fa fa-trash'></i>
						</a>
						<a data-action='edit-item'>
							<i class='fa-solid fa-fw fa-edit'></i>
						</a>
					</div>
				</div>
			</div>
		{{/each}}
	</section>
	<section class='weapons'>
		<div class='section-header'>{{localize 'Madness.Label.Weapons'}}</div>
		<div class='row'>
			<div class='item-name'>{{localize 'Madness.Label.Name'}}</div>
			<div></div>
			<div>{{localize 'Madness.Item.Weapon.Ammo'}}</div>
			<div>{{localize 'Madness.Label.Damage'}} <br /> min-max</div>
			<div>{{localize 'Madness.Item.Range'}}</div>
		</div>
		{{#each weapons}}
			<div class='item weapon' data-id='{{id}}'>
				<div class='row'>
					<div class='item-name'>{{name}}</div>
					<div>
						{{#if reloadable}}
							<button class='action' data-action='reload-weapon'>
								{{localize 'Madness.Controls.Reload'}}
							</button>
						{{/if}}
					</div>
					<div>
						{{#if (and useAmmo system.ammo.max)}}
							{{system.ammo.value}}/{{system.ammo.max}}
						{{else}}
							-
						{{/if}}
					</div>
					<div>
						{{minDamage}}
						-
						{{maxDamage}}
					</div>
					<div>{{range}}</div>
					<button class='action' data-action='roll-weapon'>
						{{localize 'Madness.Controls.Attack'}}
					</button>
					<div class='delete'>
						<a data-action='delete'>
							<i class='fa fa-trash'></i>
						</a>
						<a data-action='edit-item'>
							<i class='fa-solid fa-fw fa-edit'></i>
						</a>
					</div>
				</div>
			</div>
		{{/each}}
	</section>
</section>