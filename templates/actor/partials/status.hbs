<section class='tab status' data-tab='status'>
	<section class='passives'>
		<div class='section-header top'>
			<div>{{localize 'Madness.Label.PersonalPassives'}}</div>
			<div class='decoration'>
				<div></div>
				<div></div>
			</div>
		</div>
		<div class='content'>
			{{> 'madness.partials.passives'}}
		</div>
	</section>
	<section class='other-passives'>
		<div class='section-header top'>
			<div>{{localize 'Madness.Label.OtherPassives'}}</div>
			<div class='decoration'>
				<div></div>
				<div></div>
			</div>
		</div>
		<div class='content'>
			<div class='other-passives-grid grid'>
				<div class='row head'>
					<div>{{localize 'Madness.Label.Name'}}</div>
					<div class='description'>
						{{localize 'Madness.Label.Description'}}
					</div>
					<div class='actions'></div>
				</div>
				{{#each otherPassives}}
					<div class='row'>
						<div class='item-name'>{{name}}
							({{localize (concat 'Madness.Label.' (capitalize source))}})
						</div>
						<div class='description'>
							{{#each passives}}
								<div class='passive-description'>
									<div class='align-left'>
										{{name}}
									</div>
									<div class='align-left'>
										{{#if passive}}
											{{localize
												(concat
													'Madness.Passives.'
													(capitalize type)
													'.'
													(capitalize passive)
												)
											}}
										{{/if}}
										{{#if strength}}
											:
										{{/if}}
										{{strength}}
										<br />
										{{description}}
									</div>
									<div>
										<input type='checkbox' {{checked active}} disabled />
									</div>
								</div>
							{{/each}}
						</div>
						<div class='actions'></div>
					</div>
				{{/each}}
			</div>
		</div>
	</section>
	<section class='status'>
		<div class='section-header'>
			<div>{{localize 'Madness.Label.StatusPlural'}}</div>
			<div class='decoration'>
				<div></div>
				<div></div>
			</div>
		</div>
		<div class='content'>
			<div class='grid'>
				<div class='row head'>
					<div>{{localize 'Madness.Label.Status'}}</div>
					<div>{{localize 'Madness.Label.Description'}}</div>
					<div>{{localize 'Madness.Label.Stacks'}}</div>
					<div>{{localize 'Madness.Label.RemainingDuration'}}</div>
					<div class='actions'></div>
				</div>
				{{#each effects}}
					<div class='row'>
						<div class='item-name'>{{name}}</div>
						<div class='align-left'>{{description}}</div>
						<div>{{system.stacks}}</div>
						<div>
							{{#each system.durations}}
								{{value}}
								{{type}}
								<br />
							{{/each}}
						</div>
						<div class='actions'></div>
					</div>
				{{/each}}
			</div>
		</div>
	</section>
</section>