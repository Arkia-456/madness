<section class='tab status' data-tab='status'>
	<div class='passives'>
		<div class='section-header top'>
			{{localize 'Madness.Label.PersonalPassives'}}
		</div>
		<a data-action='create-passive'>
			<i class='fa-plus'></i>
		</a>
		<div class='grid'>
			<div class='row head'>
				<div>{{localize 'Madness.Label.Passive'}}</div>
				<div>{{localize 'Madness.Label.Description'}}</div>
				<div>{{localize 'Madness.Label.Strength'}}</div>
				<div>{{localize 'Madness.Label.Active'}}</div>
			</div>
			{{#each system.passives as |p id|}}
				<div class='row'>
					<div>
						<input
							class='value'
							type='text'
							name='system.passives.{{id}}.name'
							value='{{p.name}}'
						/>
					</div>
					<div>
						<select name='system.passives.{{id}}.passive'>
							<option value=''></option>
							{{selectOptions
								(localizeAndSort @root.passives)
								selected=p.passive
								localize=true
							}}
						</select>
					</div>
					<div>
						<input
							class='value'
							type='number'
							name='system.passives.{{id}}.strength'
							value='{{p.strength}}'
						/>
					</div>
					<div class='active'>
						<input
							type='checkbox'
							name='system.passives.{{id}}.active'
							{{checked p.active}}
						/>
					</div>
				</div>
			{{/each}}
		</div>
	</div>
	<div class='status'>
		<div class='section-header'>{{localize 'Madness.Label.StatusPlural'}}</div>
		<div class='grid'>
			<div class='row head'>
				<div>{{localize 'Madness.Label.Status'}}</div>
				<div>{{localize 'Madness.Label.Description'}}</div>
				<div>{{localize 'Madness.Label.Stacks'}}</div>
				<div>{{localize 'Madness.Label.RemainingDuration'}}</div>
			</div>
			{{#each effects}}
				<div class='row'>
					<div>{{name}}</div>
					<div class='align-left'>{{description}}</div>
					<div>{{system.stacks}}</div>
					<div>
						{{#each system.durations}}
							{{value}}
							{{type}}
							<br />
						{{/each}}
					</div>
				</div>
			{{/each}}
		</div>

	</div>
</section>