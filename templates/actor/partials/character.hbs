<section class='tab character' data-tab='character'>
	<div class='header'>
		<div class='picture'>
			<img src='{{actor.img}}' data-edit='img' />
		</div>
		<div class='identity'>
			<div>
				<label class='details-label'>
					{{localize 'Madness.Character.LastName'}}
				</label>
				<input
					class='value'
					name='system.lastName'
					type='text'
					value='{{system.lastName}}'
				/>
			</div>
			<div>
				<label class='details-label'>
					{{localize 'Madness.Character.FirstName'}}
				</label>
				<input class='value' name='name' type='text' value='{{actor.name}}' />
			</div>
			<div>
				<label class='details-label'>
					{{localize 'Madness.Character.Age'}}
				</label>
				<input
					class='value'
					name='system.age'
					type='text'
					value='{{system.age}}'
				/>
			</div>
			<div>
				<span class='details-label'>
					{{localize 'Madness.Character.Ethnicity'}}
				</span>
				<input
					class='value'
					name='ethnicity.name'
					type='text'
					value='{{ethnicity.name}}'
					readonly
				/>
				{{#if @root}}
					{{#if ethnicity}}
						<span class='detail-item-control' data-item-id='{{ethnicity.id}}'>
							<i class='fa-solid fa-fw fa-ellipsis-v'></i>
						</span>
					{{else}}
						<a
							data-action='open-compendium'
							data-compendium='madness-compendium.ethnies'
						>
							<i class='fa-solid fa-fw fa-search'></i>
						</a>
					{{/if}}
				{{/if}}
			</div>
			<div>
				<label class='details-label'>
					{{localize 'Madness.Character.Job'}}
				</label>
				<input
					class='value'
					name='system.job'
					type='text'
					value='{{system.job}}'
				/>
			</div>
			<div>
				<label class='details-label'>
					{{localize 'Madness.Character.Faction'}}
				</label>
				<input
					class='value'
					name='system.faction'
					type='text'
					value='{{system.faction}}'
				/>
			</div>
		</div>
	</div>
	<div class='content'>
		<div class='state'>
			<div class='container hp'>
				<label>{{localize 'Madness.Label.HitPoints'}}</label>
				<div class='points-value'>
					<input
						name='system.hp.value'
						type='number'
						value='{{system.hp.value}}'
						placeholder='0'
					/><span>/</span><span>{{system.hp.max}}</span>
				</div>
			</div>
			<div class='container temp-hp'>
				<label>{{localize 'Madness.Label.BarrierPoints'}}</label>
				<div class='points-value'>
					<input
						name='system.hp.temp'
						type='number'
						value='{{system.hp.temp}}'
						placeholder='0'
					/>
				</div>
			</div>
			<div class='container mp'>
				<label>{{localize 'Madness.Label.ManaPoints'}}</label>
				<div class='points-value'>
					<input
						name='system.mp.value'
						type='number'
						value='{{system.mp.value}}'
						placeholder='0'
					/><span>/</span><span>{{system.mp.max}}</span>
				</div>
			</div>
			<div class='container ap'>
				<label>{{localize 'Madness.Label.ArmorPoints'}}</label>
				<div class='points-value'>
					<span>{{system.armor.total}}</span>
				</div>
			</div>
		</div>
		<div class='stats'>
			<div class='stats-tables'>
				<table class='attributes'>
					<tr>
						<td class='attribute-header' rowspan='3'>
							<a
								class='roll-icon'
								data-action='roll-check'
								data-attribute='{{system.attributes.agi.id}}'
							>
								<i class='fa-solid fa-fw fa-dice-d20'></i>
							</a>
						</td>
						<td
							class='attribute-header primary-attribute'
							rowspan='3'
							data-action='edit-attributes'
						>
							{{system.attributes.agi.label}}
						</td>
						<td
							rowspan='3'
							class='attribute-total primary-attribute'
							data-id='{{system.attributes.agi.id}}'
							data-action='edit-attributes'
						>
							{{system.attributes.agi.total}}
						</td>
						<td class='attribute-header'>
							{{#if system.secondaryAttributes.initiative.rollable}}
								<a
									class='roll-icon'
									data-action='roll-check'
									data-secondary-attribute='{{system.secondaryAttributes.initiative.id}}'
								>
									<i class='fa-solid fa-fw fa-dice-d20'></i>
								</a>
							{{/if}}
						</td>
						<td class='attribute-header'>
							{{system.secondaryAttributes.initiative.label}}
						</td>
						<td
							class='attribute-total'
							data-id='{{system.secondaryAttributes.initiative.id}}'
						>
							{{system.secondaryAttributes.initiative.total}}
						</td>
					</tr>
					<tr>
						<td class='attribute-header'>
							{{#if system.secondaryAttributes.dodgeRate.rollable}}
								<a
									class='roll-icon'
									data-action='roll-check'
									data-secondary-attribute='{{system.secondaryAttributes.dodgeRate.id}}'
								>
									<i class='fa-solid fa-fw fa-dice-d20'></i>
								</a>
							{{/if}}
						</td>
						<td class='attribute-header'>
							{{system.secondaryAttributes.dodgeRate.label}}
						</td>
						<td
							class='attribute-total'
							data-id='{{system.secondaryAttributes.dodgeRate.id}}'
						>
							{{system.secondaryAttributes.dodgeRate.total}}
						</td>
					</tr>
					<tr>
						<td class='attribute-header'>
							{{#if system.secondaryAttributes.maxMoveDistance.rollable}}
								<a
									class='roll-icon'
									data-action='roll-check'
									data-secondary-attribute='{{system.secondaryAttributes.maxMoveDistance.id}}'
								>
									<i class='fa-solid fa-fw fa-dice-d20'></i>
								</a>
							{{/if}}
						</td>
						<td class='attribute-header'>
							{{system.secondaryAttributes.maxMoveDistance.label}}
						</td>
						<td
							class='attribute-total'
							data-id='{{system.secondaryAttributes.maxMoveDistance.id}}'
						>
							{{system.secondaryAttributes.maxMoveDistance.total}}
						</td>
					</tr>
					<tr>
						<td class='attribute-header'>
							<a
								class='roll-icon'
								data-action='roll-check'
								data-attribute='{{system.attributes.con.id}}'
							>
								<i class='fa-solid fa-fw fa-dice-d20'></i>
							</a>
						</td>
						<td
							class='attribute-header primary-attribute'
							data-action='edit-attributes'
						>
							{{system.attributes.con.label}}
						</td>
						<td
							class='attribute-total primary-attribute'
							data-action='edit-attributes'
							data-id='{{system.attributes.con.id}}'
						>
							{{system.attributes.con.total}}
						</td>
						<td class='attribute-header'>
							{{#if system.secondaryAttributes.parryDamageReduction.rollable}}
								<a
									class='roll-icon'
									data-action='roll-check'
									data-secondary-attribute='{{system.secondaryAttributes.parryDamageReduction.id}}'
								>
									<i class='fa-solid fa-fw fa-dice-d20'></i>
								</a>
							{{/if}}
						</td>
						<td class='attribute-header'>
							{{system.secondaryAttributes.parryDamageReduction.label}}
						</td>
						<td
							class='attribute-total'
							data-id='{{system.secondaryAttributes.parryDamageReduction.id}}'
						>
							{{system.secondaryAttributes.parryDamageReduction.total}}
						</td>
					</tr>
					<tr>
						<td class='attribute-header'>
							<a
								class='roll-icon'
								data-action='roll-check'
								data-attribute='{{system.attributes.dex.id}}'
							>
								<i class='fa-solid fa-fw fa-dice-d20'></i>
							</a>
						</td>
						<td
							class='attribute-header primary-attribute'
							data-action='edit-attributes'
						>
							{{system.attributes.dex.label}}
						</td>
						<td
							class='attribute-total primary-attribute'
							data-action='edit-attributes'
							data-id='{{system.attributes.dex.id}}'
						>
							{{system.attributes.dex.total}}
						</td>
						<td class='attribute-header'>
							{{#if system.secondaryAttributes.critRate.rollable}}
								<a
									class='roll-icon'
									data-action='roll-check'
									data-secondary-attribute='{{system.secondaryAttributes.critRate.id}}'
								>
									<i class='fa-solid fa-fw fa-dice-d20'></i>
								</a>
							{{/if}}
						</td>
						<td class='attribute-header'>
							{{system.secondaryAttributes.critRate.label}}
						</td>
						<td
							class='attribute-total'
							data-id='{{system.secondaryAttributes.critRate.id}}'
						>
							{{system.secondaryAttributes.critRate.total}}
						</td>
					</tr>
					<tr>
						<td class='attribute-header'>
							<a
								class='roll-icon'
								data-action='roll-check'
								data-attribute='{{system.attributes.int.id}}'
							>
								<i class='fa-solid fa-fw fa-dice-d20'></i>
							</a>
						</td>
						<td
							class='attribute-header primary-attribute'
							data-action='edit-attributes'
						>
							{{system.attributes.int.label}}
						</td>
						<td
							class='attribute-total primary-attribute'
							data-action='edit-attributes'
							data-id='{{system.attributes.int.id}}'
						>
							{{system.attributes.int.total}}
						</td>
						<td class='attribute-header'>
							{{#if system.secondaryAttributes.manaRegen.rollable}}
								<a
									class='roll-icon'
									data-action='roll-check'
									data-secondary-attribute='{{system.secondaryAttributes.manaRegen.id}}'
								>
									<i class='fa-solid fa-fw fa-dice-d20'></i>
								</a>
							{{/if}}
							<a
								class='roll-icon'
								data-action='addMP'
								data-secondary-attribute='{{system.secondaryAttributes.manaRegen.id}}'
							>
								<i class='fa-solid fa-fw fa-undo-alt'></i>
							</a>
						</td>
						<td class='attribute-header'>
							{{system.secondaryAttributes.manaRegen.label}}
						</td>
						<td
							class='attribute-total'
							data-id='{{system.secondaryAttributes.manaRegen.id}}'
						>
							{{system.secondaryAttributes.manaRegen.total}}
						</td>
					</tr>
					<tr>
						<td class='attribute-header' rowspan='3'>
							<a
								class='roll-icon'
								data-action='roll-check'
								data-attribute='{{system.attributes.str.id}}'
							>
								<i class='fa-solid fa-fw fa-dice-d20'></i>
							</a>
						</td>
						<td
							class='attribute-header primary-attribute'
							data-action='edit-attributes'
							rowspan='3'
						>
							{{system.attributes.str.label}}
						</td>
						<td
							rowspan='3'
							class='attribute-total primary-attribute'
							data-action='edit-attributes'
							data-id='{{system.attributes.str.id}}'
						>
							{{system.attributes.str.total}}
						</td>
						<td class='attribute-header'>
							{{#if system.secondaryAttributes.maxEquipmentWeight.rollable}}
								<a
									class='roll-icon'
									data-action='roll-check'
									data-secondary-attribute='{{system.secondaryAttributes.maxEquipmentWeight.id}}'
								>
									<i class='fa-solid fa-fw fa-dice-d20'></i>
								</a>
							{{/if}}
						</td>
						<td class='attribute-header'>
							{{system.secondaryAttributes.maxEquipmentWeight.label}}
						</td>
						<td
							class='attribute-total'
							data-id='{{system.secondaryAttributes.maxEquipmentWeight.id}}'
						>
							{{system.secondaryAttributes.maxEquipmentWeight.total}}
						</td>
					</tr>
					<tr>
						<td class='attribute-header'>
							{{#if system.secondaryAttributes.maxWeight.rollable}}
								<a
									class='roll-icon'
									data-action='roll-check'
									data-secondary-attribute='{{system.secondaryAttributes.maxWeight.id}}'
								>
									<i class='fa-solid fa-fw fa-dice-d20'></i>
								</a>
							{{/if}}
						</td>
						<td class='attribute-header'>
							{{system.secondaryAttributes.maxWeight.label}}
						</td>
						<td
							class='attribute-total'
							data-id='{{system.secondaryAttributes.maxWeight.id}}'
						>
							{{system.secondaryAttributes.maxWeight.total}}
						</td>
					</tr>
					<tr>
						<td class='attribute-header'>
							{{#if system.secondaryAttributes.inventoryMaxSlots.rollable}}
								<a
									class='roll-icon'
									data-action='roll-check'
									data-secondary-attribute='{{system.secondaryAttributes.inventoryMaxSlots.id}}'
								>
									<i class='fa-solid fa-fw fa-dice-d20'></i>
								</a>
							{{/if}}
						</td>
						<td class='attribute-header'>
							{{system.secondaryAttributes.inventoryMaxSlots.label}}
						</td>
						<td
							class='attribute-total'
							data-id='{{system.secondaryAttributes.inventoryMaxSlots.id}}'
						>
							{{system.secondaryAttributes.inventoryMaxSlots.total}}
						</td>
					</tr>
				</table>
				<table class='magics' data-action='edit-magics'>
					{{#each system.magics as |magic id|}}
						<tr class='attribute magic' data-id='{{id}}'>
							<td class='attribute-header'>{{magic.label}}</td>
							<td class='attribute-total'>{{magic.total}}</td>
						</tr>
					{{/each}}
					{{#each system.secondaryMagics as |magic id|}}
						<tr class='attribute magic' data-id='{{id}}'>
							<td class='attribute-header'>{{magic.label}}</td>
							<td class='attribute-total'>{{magic.total}}</td>
						</tr>
					{{/each}}
				</table>
			</div>
			<table class='weapons'>
				<tbody>
					{{#each weapons as |weapon id|}}
						<tr>
							<td class='weapon-header name'>{{name}}</td>
							<td class='weapon-header ammo'>
								{{localize 'Madness.Item.Weapon.Ammo'}}
							</td>
							<td>
								{{#if weapon.useAmmo}}
									{{weapon.system.ammo.value}}/{{weapon.system.ammo.max}}
								{{else}}
									-
								{{/if}}
							</td>
						</tr>
					{{/each}}
				</tbody>
			</table>
		</div>
	</div>
</section>