<form autocomplete='off'>
	<table class='magics'>
		{{#each system.magics as |magic id|}}
			<tr data-id='{{id}}'>
				<td class='header attribute-header'>
					{{localize (lookup @root.magics id)}}
				</td>
				<td class='value' data-id='{{id}}'>
					<input
						type='number'
						name='{{id}}'
						value='{{magic.value}}'
						min='0'
						step='1'
					/>
				</td>
			</tr>
		{{/each}}
	</table>
	<button type='submit'>
		<i class='fa-regular fa-save'></i>
		{{localize 'Save'}}
	</button>
</form>