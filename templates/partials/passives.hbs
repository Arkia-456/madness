<div class='passives-grid'>
	<div class='row head'>
		<div>{{localize 'Madness.Label.Passive'}}</div>
		<div>{{localize 'Madness.Label.Description'}}</div>
		<div>{{localize 'Madness.Label.Strength'}}</div>
		<div>{{localize 'Madness.Label.Active'}}</div>
		<div class='actions'></div>
	</div>
	{{#each system.passives as |p id|}}
		<div class='row' data-id='{{id}}'>
			<div class='name'>
				<input
					class='value'
					type='text'
					name='system.passives.{{id}}.name'
					value='{{p.name}}'
				/>
			</div>
			<div>
				<select name='system.passives.{{id}}.passive'>
					<option value=''></option>
					{{selectOptions
						(localizeAndSort @root.passives)
						selected=p.passive
						localize=true
					}}
				</select>
			</div>
			<div>
				<input
					class='value'
					type='number'
					name='system.passives.{{id}}.strength'
					value='{{p.strength}}'
				/>
			</div>
			<div class='active'>
				<input
					type='checkbox'
					name='system.passives.{{id}}.active'
					{{checked p.active}}
				/>
			</div>
			<div class='actions'>
				{{#if @root.editable}}
					<a data-action='delete-passive'>
						<i class='fa fa-trash'></i>
					</a>
				{{/if}}
			</div>
			<div class='description'>
				<textarea
					class='value'
					name='system.passives.{{id}}.description'
				>{{p.description}}</textarea>
			</div>
		</div>
	{{/each}}
</div>
<div>
	{{#if editable}}
		<button class='add-passive' data-action='create-passive'>
			<i class='fa fa-plus'></i>
		</button>
	{{/if}}
</div>