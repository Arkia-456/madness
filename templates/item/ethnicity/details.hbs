<ul>
	{{#each system.attributes as |attribute id|}}
		<li data-attribute='{{id}}'>
			<span id='{{id}}'>{{id}}</span>
			<input
				type='number'
				name='system.attributes.{{id}}.value'
				value='{{attribute.value}}'
				data-dtype='Number'
			/>
		</li>
	{{/each}}
</ul>
<div>
	<label>{{localize 'Madness.Label.HitPoints'}}</label>
	<input name='system.hp' type='number' value='{{system.hp}}' />
</div>
<div>
	<label>{{localize 'Madness.Label.ManaPoints'}}</label>
	<input name='system.mp' type='number' value='{{system.mp}}' />
</div>
<div>
	<label>{{localize 'Madness.Label.Armor'}}</label>
	<input name='system.armor' type='number' value='{{system.armor}}' />
</div>
<div>
	<label>{{localize 'Madness.Label.Immunity'}}</label>
	<select name='system.immunity'>
		<option value=''></option>
		{{selectOptions statusEffects selected=system.immunity localize=true}}
	</select>
</div>