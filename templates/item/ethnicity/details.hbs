<table class='attributes-table'>
	<thead>
		<tr class='table-header'>
			<td colspan='5'>{{localize 'Madness.Label.Attributes'}}</td>
		</tr>
		<tr>
			{{#each system.attributes as |attribute id|}}
				<td>{{localize (lookup @root.attributesLabels id)}}</td>
			{{/each}}
		</tr>
	</thead>
	<tbody>
		<tr>
			{{#each system.attributes as |attribute id|}}
				<td data-attribute='{{id}}'>
					<input
						type='number'
						name='system.attributes.{{id}}.value'
						value='{{attribute.value}}'
						data-dtype='Number'
					/>
				</td>
			{{/each}}
		</tr>
	</tbody>
</table>
<table>
	<thead>
		<tr>
			<td>{{localize 'Madness.Label.HitPoints'}}</td>
			<td>{{localize 'Madness.Label.ManaPoints'}}</td>
		</tr>
	</thead>
	<tbody>
		<tr>
			<td>
				<input name='system.hp' type='number' value='{{system.hp}}' />
			</td>
			<td>
				<input name='system.mp' type='number' value='{{system.mp}}' />
			</td>
		</tr>
	</tbody>
</table>
{{> 'madness.partials.passives'}}