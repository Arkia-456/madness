<table>
	<thead>
		<tr>
			<td>{{localize 'Madness.Label.Magic'}}</td>
			<td>{{localize 'Madness.Label.Magic'}}</td>
			<td>{{localize 'Madness.Item.Spell.Cost'}}</td>
			<td>{{localize 'Madness.Item.Range'}}</td>
		</tr>
	</thead>
	<tbody>
		<tr>
			<td>
				<select name='system.requirements.magic0.id'>
					<option value=''></option>
					{{selectOptions
						magics
						selected=system.requirements.magic0.id
						localize=true
					}}
				</select>
			</td>
			<td>
				<select name='system.requirements.magic1.id'>
					<option value=''></option>
					{{selectOptions
						magics
						selected=system.requirements.magic1.id
						localize=true
					}}
				</select>
			</td>
			<td>
				<input
					type='number'
					name='system.cost.value'
					value='{{system.cost.value}}'
					data-dtype='number'
				/>
				{{localize 'Madness.Label.MP'}}
			</td>
			<td>
				<input
					type='number'
					name='system.range.value'
					value='{{system.range.value}}'
					data-dtype='number'
				/>
			</td>
		</tr>
	</tbody>
</table>
{{> 'madness.item.skill.details'}}