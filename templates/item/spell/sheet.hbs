<form class='{{cssClass}}' autocomplete='off' data-drop-type='effect'>
	<header class='sheet-header'>
		{{#if editable}}
			<input
				name='name'
				type='text'
				value='{{item._source.name}}'
				placeholder='{{localize "Madness.Item.NamePlaceholder"}}'
				spellcheck='false'
			/>
		{{else}}
			<span>{{item._source.name}}</span>
		{{/if}}
	</header>
	<section class='sheet-content'>
		<div class='description'>
			<p>{{localize 'Madness.Label.Description'}}</p>
			{{editor
				enrichedContent.description
				target='system.description'
				button=true
				editable=editable
				engine='prosemirror'
			}}
		</div>
		<div class='details'>
			<div>
				<p>{{localize 'Madness.Label.Magics'}}</p>
				<select name='system.requirements.magic0.id'>
					<option value=''></option>
					{{selectOptions
						config.magics
						selected=system.requirements.magic0.id
						localize=true
					}}
				</select>
				<select name='system.requirements.magic1.id'>
					<option value=''></option>
					{{selectOptions
						config.magics
						selected=system.requirements.magic1.id
						localize=true
					}}
				</select>
			</div>
			<div>
				<label>{{localize 'Madness.Item.Range'}}</label>
				<input
					type='number'
					name='system.range.value'
					value='{{system.range.value}}'
					data-dtype='number'
				/>
				m
			</div>
			<div>
				<p>{{localize 'Madness.Item.Damage'}}</p>
				<div class='damage-grid'>
					{{#each config.attributes as |attr i|}}
						<div class='attribute-damage'>
							<div class='attribute-name'>{{localize attr}}</div>
							<div>
								<input
									type='number'
									name='system.damage.{{i}}'
									value='{{lookup @root.system.damage i}}'
									data-dtype='number'
								/>
								d
							</div>
						</div>
					{{/each}}
					<div class='attribute-damage'>
						<div class='attribute-name'>{{localize 'Madness.Item.Flat'}}</div>
						<div>
							<input
								type='number'
								name='system.damage.flat'
								value='{{system.damage.flat}}'
								data-dtype='number'
							/>
						</div>
					</div>
				</div>
				<div>
					<label>{{localize 'Madness.Item.Spell.Cost'}}</label>
					<input
						type='number'
						name='system.cost.value'
						value='{{system.cost.value}}'
						data-dtype='number'
					/>
					{{localize 'Madness.Label.MP'}}
				</div>
			</div>
		</div>
		<div class='item-list'>
			<p>{{localize 'Madness.Label.Effects'}}</p>
			<div>
				{{#each system.items as |effect i|}}
					{{> "madness.item.effect-line" this=effect}}
				{{/each}}
			</div>
		</div>
	</section>
</form>