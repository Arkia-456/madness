<div>
	<label>{{localize 'Madness.Equipment.Slot'}}</label>
	<select name='system.slot'>
		<option value=''></option>
		{{selectOptions slots selected=system.slot localize=true}}
	</select>
</div>
<div>
	<label>{{localize 'Madness.Label.Armor'}}</label>
	<input
		type='number'
		name='system.armor'
		value='{{system.armor}}'
		data-dtype='number'
	/>
</div>
<div>
	<label>{{localize 'Madness.Label.Weight'}}</label>
	<input
		type='number'
		name='system.weight'
		value='{{system.weight}}'
		data-dtype='number'
	/>
</div>
<div>
	<button data-action='create-passive'>
		<i class='fa fa-plus'></i>
		{{localize 'Madness.Controls.AddPassive'}}
	</button>
</div>
<div class='grid'>
	<div class='row head'>
		<div>{{localize 'Madness.Label.Passive'}}</div>
		<div>{{localize 'Madness.Label.Description'}}</div>
		<div>{{localize 'Madness.Label.Strength'}}</div>
		<div>{{localize 'Madness.Label.Active'}}</div>
		<div class='actions'></div>
	</div>
	{{#each system.passives as |p id|}}
		<div class='row' data-id='{{id}}'>
			<div class='name'>
				<input
					class='value'
					type='text'
					name='system.passives.{{id}}.name'
					value='{{p.name}}'
				/>
			</div>
			<div>
				<select name='system.passives.{{id}}.passive'>
					<option value=''></option>
					{{selectOptions
						(localizeAndSort @root.passives)
						selected=p.passive
						localize=true
					}}
				</select>
			</div>
			<div>
				<input
					class='value'
					type='number'
					name='system.passives.{{id}}.strength'
					value='{{p.strength}}'
				/>
			</div>
			<div class='active'>
				<input
					type='checkbox'
					name='system.passives.{{id}}.active'
					{{checked p.active}}
				/>
			</div>
			<div class='actions'>
				<a data-action='delete-passive'>
					<i class='fa fa-trash'></i>
				</a>
			</div>
			<div class='description'>
				<textarea
					class='value'
					name='system.passives.{{id}}.description'
				>{{p.description}}</textarea>
			</div>
		</div>
	{{/each}}
</div>