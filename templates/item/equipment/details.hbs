<table class='equipment-stats'>
	<thead>
		<tr>
			<td>{{localize 'Madness.Equipment.Slot'}}</td>
			<td>{{localize 'Madness.Label.Armor'}}</td>
			<td>{{localize 'Madness.Label.Weight'}}</td>
		</tr>
	</thead>
	<tbody>
		<tr>
			<td>
				<select name='system.slot'>
					<option value=''></option>
					{{selectOptions slots selected=system.slot localize=true}}
				</select>
			</td>
			<td>
				<input
					type='number'
					name='system.armor'
					value='{{system.armor}}'
					data-dtype='number'
				/>
			</td>
			<td>
				<input
					type='number'
					name='system.weight'
					value='{{system.weight}}'
					data-dtype='number'
				/>
			</td>
		</tr>
	</tbody>
</table>
{{> 'madness.partials.passives'}}