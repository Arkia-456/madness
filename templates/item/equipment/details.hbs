<div>
	<label>{{localize 'Madness.Equipment.Slot'}}</label>
	<select name='system.slot'>
		<option value=''></option>
		{{selectOptions slots selected=system.slot localize=true}}
	</select>
</div>
<div>
	<label>{{localize 'Madness.Label.Armor'}}</label>
	<input
		type='number'
		name='system.armor'
		value='{{system.armor}}'
		data-dtype='number'
	/>
</div>
<div>
	<label>{{localize 'Madness.Label.Weight'}}</label>
	<input
		type='number'
		name='system.weight'
		value='{{system.weight}}'
		data-dtype='number'
	/>
</div>
<a data-action='create-passive'>
	<i class='fa-plus'></i>
</a>
<table class='passives'>
	<tr>
		<td>Nom</td>
		<td>Passif</td>
		<td>Puissance</td>
		<td>Actif</td>
	</tr>
	{{#each system.passives as |p id|}}
		<tr data-id='{{id}}'>
			<td>
				<input
					class='value'
					type='text'
					name='system.passives.{{id}}.name'
					value='{{p.name}}'
				/>
			</td>
			<td>
				<select name='system.passives.{{id}}.passive'>
					<option value=''></option>
					{{selectOptions
						(localizeAndSort @root.passives)
						selected=p.passive
						localize=true
					}}
				</select>
			</td>
			<td>
				<input
					class='value'
					type='number'
					name='system.passives.{{id}}.strength'
					value='{{p.strength}}'
				/>
			</td>
			<td>
				<input
					type='checkbox'
					name='system.passives.{{id}}.active'
					{{checked p.active}}
				/>
			</td>
			<td class='actions'>
				<a data-action='delete-passive'>
					<i class='fa fa-trash'></i>
				</a>
			</td>
		</tr>
	{{/each}}
</table>