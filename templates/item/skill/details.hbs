<table class='damage-table'>
	<thead>
		<tr class='table-header'>
			<td colspan='6'>{{localize 'Madness.Item.Damage'}}</td>
		</tr>
		<tr>
			{{#each attributes as |attr i|}}
				<td>{{localize attr}}</td>
			{{/each}}
			<td>{{localize 'Madness.Item.Flat'}}</td>
		</tr>
	</thead>
	<tbody>
		<tr>
			{{#each attributes as |attr i|}}
				<td>
					<input
						type='number'
						name='system.damage.{{i}}'
						value='{{lookup @root.system.damage i}}'
						data-dtype='number'
					/>
					d
				</td>
			{{/each}}
			<td>
				<input
					type='number'
					name='system.damage.flat'
					value='{{system.damage.flat}}'
					data-dtype='number'
				/>
			</td>
		</tr>
	</tbody>
</table>
<div class='item-list'>
	<span>{{localize 'Madness.Label.Effects'}}</span>
	<a data-action='open-compendium' data-compendium='madness-compendium.effects'>
		<i class='fa-solid fa-fw fa-search'></i>
	</a>
	<div>
		{{#each system.items as |effect i|}}
			{{> "madness.item.effect-line" this=effect}}
		{{/each}}
	</div>
</div>