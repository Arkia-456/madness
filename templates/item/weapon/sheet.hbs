<form class='{{cssClass}}' autocomplete='off' data-drop-type='effect'>
	<header class='sheet-header'>
		<img src='{{item._source.img}}' data-edit='img' />
		<input
			name='name'
			type='text'
			value='{{item._source.name}}'
			placeholder='{{localize "Madness.Item.NamePlaceholder"}}'
			spellcheck='false'
		/>
	</header>
	<section class='sheet-content'>
		<div class='description'>
			{{editor
				enrichedContent.description
				target='system.description'
				button=true
				editable=editable
				engine='prosemirror'
			}}
		</div>
		<div class='details'>
			<div>
				{{localize 'Madness.Item.Weapon.Modules'}}
				<ul>
					<li>
						<select name='system.modules.module0.id'>
							<option value=''></option>
							{{selectOptions
								config.modules
								selected=system.modules.module0.id
								localize=true
							}}
						</select>
						<label>{{localize 'Madness.Item.Level'}}</label>
						<input
							type='number'
							name='system.modules.module0.value'
							value='{{system.modules.module0.value}}'
							data-dtype='number'
						/>
						<select name='system.modules.module1.id'>
							<option value=''></option>
							{{selectOptions
								config.modules
								selected=system.modules.module1.id
								localize=true
							}}
						</select>
						<label>{{localize 'Madness.Item.Level'}}</label>
						<input
							type='number'
							name='system.modules.module1.value'
							value='{{system.modules.module1.value}}'
							data-dtype='number'
						/>
					</li>
				</ul>
			</div>
			<div>
				<label>{{localize 'Madness.Item.Range'}}</label>
				<input
					type='number'
					name='system.range.value'
					value='{{system.range.value}}'
					data-dtype='number'
				/>
			</div>
			<div>
				{{localize 'Madness.Item.Damage'}}
				<ul>
					{{#each config.attributes as |attr i|}}
						<li>
							<label>{{localize attr}}</label>
							<input
								type='number'
								name='system.damage.{{i}}'
								value='{{lookup @root.system.damage i}}'
								data-dtype='number'
							/>
						</li>
					{{/each}}
					<li>
						<label>{{localize 'Madness.Item.Flat'}}</label>
						<input
							type='number'
							name='system.damage.flat'
							value='{{system.damage.flat}}'
							data-dtype='number'
						/>
					</li>
				</ul>
			</div>
			<div>
				<label>{{localize 'Madness.Item.Weapon.Ammo'}}</label>
				<input
					type='number'
					name='system.ammo.max'
					value='{{system.ammo.max}}'
					data-dtype='number'
				/>
			</div>
			<div>
				<label>{{localize 'Madness.Label.Weight'}}</label>
				<input
					type='number'
					name='system.weight'
					value='{{system.weight}}'
					data-dtype='number'
				/>
			</div>
		</div>
		<div class='item-list'>
			<p>{{localize 'Madness.Label.Effects'}}</p>
			<div>
				{{#each system.items as |effect i|}}
					{{> "madness.item.effect-line" this=effect}}
				{{/each}}
			</div>
		</div>
	</section>
</form>