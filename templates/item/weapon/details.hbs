{{#if (equal type 'weapon')}}
	{{> 'madness.partials.passives'}}
{{/if}}
<table>
	<thead>
		<tr class='table-header'>
			<td colspan='4'>{{localize 'Madness.Item.Weapon.Modules'}}</td>
		</tr>
		<tr>
			<td>{{localize 'Madness.Item.Weapon.Module'}}</td>
			<td>{{localize 'Madness.Item.Level'}}</td>
			<td>{{localize 'Madness.Item.Weapon.Module'}}</td>
			<td>{{localize 'Madness.Item.Level'}}</td>
		</tr>
	</thead>
	<tbody>
		<tr>
			<td>
				<select name='system.modules.module0.id'>
					<option value=''></option>
					{{selectOptions
						modules
						selected=system.modules.module0.id
						localize=true
					}}
				</select>
			</td>
			<td>
				<input
					type='number'
					name='system.modules.module0.value'
					value='{{system.modules.module0.value}}'
					data-dtype='number'
				/>
			</td>
			<td>
				<select name='system.modules.module1.id'>
					<option value=''></option>
					{{selectOptions
						modules
						selected=system.modules.module1.id
						localize=true
					}}
				</select>
			</td>
			<td>
				<input
					type='number'
					name='system.modules.module1.value'
					value='{{system.modules.module1.value}}'
					data-dtype='number'
				/>
			</td>
		</tr>
	</tbody>
</table>
{{#if (equal type 'weapon')}}
	<table>
		<thead>
			<tr>
				{{#if isOwned}}
					<td>{{localize 'Madness.Item.Weapon.Ammo'}}</td>
				{{/if}}
				<td>{{localize 'Madness.Item.Weapon.MaxAmmo'}}</td>
				<td>{{localize 'Madness.Label.Reloadable'}}</td>
				<td>{{localize 'Madness.Label.Weight'}}</td>
				<td>{{localize 'Madness.Item.Range'}}</td>
			</tr>
		</thead>
		<tr>
			{{#if isOwned}}
				<td>
					<input
						type='number'
						name='system.ammo.value'
						value='{{system.ammo.value}}'
						data-dtype='number'
					/>
				</td>
			{{/if}}
			<td>
				<input
					type='number'
					name='system.ammo.max'
					value='{{system.ammo.max}}'
					data-dtype='number'
				/>
			</td>
			<td>
				<input
					type='checkbox'
					name='system.allowReload'
					{{checked system.allowReload}}
				/>
			</td>
			<td>
				<input
					type='number'
					name='system.weight'
					value='{{system.weight}}'
					data-dtype='number'
				/>
			</td>
			<td>
				<input
					type='number'
					name='system.range.value'
					value='{{system.range.value}}'
					data-dtype='number'
				/>
			</td>
		</tr>
	</table>
{{else}}
	<label>{{localize 'Madness.Item.Range'}}</label>
	<input
		type='number'
		name='system.range.value'
		value='{{system.range.value}}'
		data-dtype='number'
	/>
{{/if}}
{{> 'madness.item.skill.details'}}