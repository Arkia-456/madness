{{> 'madness.partials.passives'}}
<div>
	{{localize 'Madness.Item.Weapon.Modules'}}
	<ul>
		<li>
			<select name='system.modules.module0.id'>
				<option value=''></option>
				{{selectOptions
					modules
					selected=system.modules.module0.id
					localize=true
				}}
			</select>
			<label>{{localize 'Madness.Item.Level'}}</label>
			<input
				type='number'
				name='system.modules.module0.value'
				value='{{system.modules.module0.value}}'
				data-dtype='number'
			/>
			<select name='system.modules.module1.id'>
				<option value=''></option>
				{{selectOptions
					modules
					selected=system.modules.module1.id
					localize=true
				}}
			</select>
			<label>{{localize 'Madness.Item.Level'}}</label>
			<input
				type='number'
				name='system.modules.module1.value'
				value='{{system.modules.module1.value}}'
				data-dtype='number'
			/>
		</li>
	</ul>
</div>
{{#if isOwned}}
	<div>
		<label>{{localize 'Madness.Item.Weapon.Ammo'}}</label>
		<input
			type='number'
			name='system.ammo.value'
			value='{{system.ammo.value}}'
			data-dtype='number'
		/>
	</div>
{{/if}}
<div>
	<label>{{localize 'Madness.Item.Weapon.MaxAmmo'}}</label>
	<input
		type='number'
		name='system.ammo.max'
		value='{{system.ammo.max}}'
		data-dtype='number'
	/>
</div>
<div>
	<label>{{localize 'Madness.Label.Weight'}}</label>
	<input
		type='number'
		name='system.weight'
		value='{{system.weight}}'
		data-dtype='number'
	/>
</div>
<div>
	<label>{{localize 'Madness.Label.Reloadable'}}</label>
	<input
		type='checkbox'
		name='system.allowReload'
		{{checked system.allowReload}}
	/>
</div>
{{> 'madness.item.skill.details'}}