<form class='{{cssClass}}' autocomplete='off'>
	<header class='sheet-header'>
		<img src='{{item._source.img}}' data-edit='img' />
		<div>
			<div class='decoration'>
				<div></div>
				<div></div>
			</div>
			<div class='name'>
				{{#if editable}}
					<input
						name='name'
						type='text'
						value='{{item._source.name}}'
						placeholder='{{localize "Madness.Item.NamePlaceholder"}}'
						spellcheck='false'
					/>
				{{else}}
					<span>{{item._source.name}}</span>
				{{/if}}
			</div>
		</div>
	</header>
	<section class='sheet-content'>
		{{#if (equal item.type 'ethnicity')}}
			{{#if detailsTemplate}}
				<div class='details'>
					{{> (lookup . 'detailsTemplate')}}
				</div>
			{{/if}}
		{{/if}}
		<div class='description'>
			<label>{{localize 'Madness.Label.Description'}}</label>
			{{editor
				enrichedContent.description
				target='system.description'
				button=true
				editable=editable
				engine='prosemirror'
			}}
		</div>
		{{#unless (equal item.type 'ethnicity')}}
			{{#if detailsTemplate}}
				<div class='details'>
					{{> (lookup . 'detailsTemplate')}}
				</div>
			{{/if}}
		{{/unless}}
	</section>
</form>