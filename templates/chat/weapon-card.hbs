<div class='chat-card item-card'>
	<div class='header'>
		{{#if (notEqual item.img 'icons/svg/item-bag.svg')}}
			<img src='{{item.img}}' />
		{{/if}}
		<h3>{{item.name}}</h3>
	</div>
	{{{item.system.description}}}
	<table class='modules'>
		{{#each item.system.modules}}
			{{#if id}}
				<tr>
					<td>
						{{localize (concat 'Madness.Modules.' (capitalize id))}}
					</td>
					<td>
						{{localize
							(concat 'Madness.Modules.' (capitalize id) 'DescriptionShort')
						}}
					</td>
				</tr>
			{{/if}}
		{{/each}}
	</table>
	<table class='stats'>
		<tr>
			<td>{{localize 'Madness.Label.DamagePlural'}}</td>
			<td>{{localize 'Madness.Item.Range'}}</td>
			<td>{{localize 'Madness.Label.Critical'}}</td>
		</tr>
		<tr>
			<td>{{roll.outcome.total}}</td>
			<td>{{item.system.range.value}}</td>
			<td>{{roll.critOutcome.roll.total}}</td>
		</tr>
	</table>
	<table class='effects'>
		<thead>
			<tr class='table-header'>
				<td colspan='2'>{{localize 'Madness.Label.Effects'}}</td>
			</tr>
		</thead>
		{{#each item.system.items as |effect i|}}
			<tr>
				<td>{{name}}</td>
				<td>
					{{stripHTML system.description}}
					{{#with (lookup @root.item.system.items _id)}}
						{{#if system.hasStrength}}
							{{system.strength}}
						{{/if}}
					{{/with}}
				</td>
			</tr>
		{{/each}}
	</table>
	{{#if roll.critOutcome.isCritical}}
		<p class='critical'>
			{{#if (eq roll.critOutcome.result 'criticalSuccess')}}
				{{upper 'Madness.ChatMessage.CriticalHit'}}
			{{else}}
				{{upper 'Madness.ChatMessage.CriticalFailure'}}
			{{/if}}
			!
		</p>
		<p class='reminder'>{{localize 'Madness.ChatMessage.CriticalReminder'}}</p>
	{{/if}}
	<div class='actions'>
		<button data-action='dodge'>{{localize 'Madness.Controls.Dodge'}}</button>
		<button data-action='parry'>{{localize 'Madness.Controls.Parry'}}</button>
		<button data-action='take-damage'>
			{{localize 'Madness.Controls.TakeDamage'}}
		</button>
	</div>
</div>